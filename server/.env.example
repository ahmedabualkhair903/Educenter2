PORT=5000
NODE_ENV=development
# SECURITY: In production, generate a secure random 32+ character string
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_random
JWT_EXPIRES_IN=7d
# Optional: separate secret + expiry for refresh tokens (falls back to JWT_SECRET / 30d)
# JWT_REFRESH_SECRET=another_super_secret_refresh_key_min_32_characters_random
# JWT_REFRESH_EXPIRES_IN=30d
# Optional: bcrypt cost for NEW password hashes (10-15, default 12). Old hashes keep working.
# BCRYPT_ROUNDS=12
# Optional: set to "false" to disable public self-registration (admin creates users only)
# ALLOW_PUBLIC_REGISTRATION=true
DATABASE_PATH=./data/educenter.db
BACKUP_PATH=./backups
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
BACKUP_SCHEDULE=0 3 * * *
WHATSAPP_WORKER_INTERVAL_MS=10000
# WhatsApp sending: "mock" (default — simulation, logs only, no real SMS)
# or "http" (real gateway). Real sending ALSO requires WHATSAPP_API_URL.
WHATSAPP_PROVIDER=mock
# Example gateways: UltraMsg / WATI / 360dialog / Twilio-compatible send endpoint
# WHATSAPP_API_URL=https://api.ultramsg.com/instance12345/messages/chat
# WHATSAPP_API_TOKEN=your_gateway_token_here
# WHATSAPP_TIMEOUT_MS=15000
